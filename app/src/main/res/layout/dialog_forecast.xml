<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:orientation="vertical"
    android:padding="20dp"
    android:background="@android:color/white">

    <TextView
        android:id="@+id/forecastTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:gravity="center"

        android:text="5 Day Forecast"
        android:textColor="@color/black"
        android:textSize="24sp"
        android:fontFamily="@font/merriweathersans_bold"

        android:layout_marginBottom="16dp" />


    <!-- DAY 1 -->

    <LinearLayout
        android:id="@+id/forecastDay1"
        android:layout_width="match_parent"
        android:layout_height="70dp"

        android:layout_marginBottom="8dp"
        android:padding="10dp"

        android:gravity="center_vertical"
        android:orientation="horizontal"

        android:background="@drawable/backgroundshape">

        <TextView
            android:id="@+id/day1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"

            android:text="Wednesday"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:fontFamily="@font/merriweathersans_bold" />

        <TextView
            android:id="@+id/condition1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"

            android:gravity="center"

            android:text="Clear"
            android:textColor="@color/black"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/temp1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"

            android:gravity="end"

            android:text="25 / 30 °C"
            android:textColor="@color/black"
            android:textSize="13sp" />

    </LinearLayout>


    <!-- DAY 2 -->

    <LinearLayout
        android:id="@+id/forecastDay2"
        android:layout_width="match_parent"
        android:layout_height="70dp"

        android:layout_marginBottom="8dp"
        android:padding="10dp"

        android:gravity="center_vertical"
        android:orientation="horizontal"

        android:background="@drawable/backgroundshape">

        <TextView
            android:id="@+id/day2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"

            android:textColor="@color/black"
            android:textSize="15sp"
            android:fontFamily="@font/merriweathersans_bold" />

        <TextView
            android:id="@+id/condition2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"

            android:gravity="center"

            android:textColor="@color/black"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/temp2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"

            android:gravity="end"

            android:textColor="@color/black"
            android:textSize="13sp" />

    </LinearLayout>


    <!-- DAY 3 -->

    <LinearLayout
        android:id="@+id/forecastDay3"
        android:layout_width="match_parent"
        android:layout_height="70dp"

        android:layout_marginBottom="8dp"
        android:padding="10dp"

        android:gravity="center_vertical"
        android:orientation="horizontal"

        android:background="@drawable/backgroundshape">

        <TextView
            android:id="@+id/day3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"

            android:textColor="@color/black"
            android:textSize="15sp"
            android:fontFamily="@font/merriweathersans_bold" />

        <TextView
            android:id="@+id/condition3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"

            android:gravity="center"

            android:textColor="@color/black"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/temp3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"

            android:gravity="end"

            android:textColor="@color/black"
            android:textSize="13sp" />

    </LinearLayout>


    <!-- DAY 4 -->

    <LinearLayout
        android:id="@+id/forecastDay4"
        android:layout_width="match_parent"
        android:layout_height="70dp"

        android:layout_marginBottom="8dp"
        android:padding="10dp"

        android:gravity="center_vertical"
        android:orientation="horizontal"

        android:background="@drawable/backgroundshape">

        <TextView
            android:id="@+id/day4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"

            android:textColor="@color/black"
            android:textSize="15sp"
            android:fontFamily="@font/merriweathersans_bold" />

        <TextView
            android:id="@+id/condition4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"

            android:gravity="center"

            android:textColor="@color/black"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/temp4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"

            android:gravity="end"

            android:textColor="@color/black"
            android:textSize="13sp" />

    </LinearLayout>


    <!-- DAY 5 -->

    <LinearLayout
        android:id="@+id/forecastDay5"
        android:layout_width="match_parent"
        android:layout_height="70dp"

        android:padding="10dp"

        android:gravity="center_vertical"
        android:orientation="horizontal"

        android:background="@drawable/backgroundshape">

        <TextView
            android:id="@+id/day5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"

            android:textColor="@color/black"
            android:textSize="15sp"
            android:fontFamily="@font/merriweathersans_bold" />

        <TextView
            android:id="@+id/condition5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"

            android:gravity="center"

            android:textColor="@color/black"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/temp5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"

            android:gravity="end"

            android:textColor="@color/black"
            android:textSize="13sp" />

    </LinearLayout>

</LinearLayout>